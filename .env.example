# docker compose では REDMINE_BASE_URL は http://redmine:3000 に上書きされる。
# REDMINE_API_KEY を空にするとモックデータで動作する（README の step 4-5 で実キーを設定）。
REDMINE_BASE_URL=https://redmine.example.com
REDMINE_API_KEY=
ANTHROPIC_API_KEY=sk-ant-your-api-key
PORT=5173
DEMO_PASSWORD=demo
JWT_SECRET=change-me-in-production
# MCP 共有サーバー（http モード）: 認証ユーザーとして Redmine を操作する場合は
# REDMINE_API_KEY に admin 権限のキーを設定し、REDMINE_SWITCH_USER=1 にする
# （Redmine 側で「ユーザーの代理」設定の有効化が必要）。空なら単一キーで動作。
REDMINE_SWITCH_USER=
